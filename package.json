{
  "name": "lumina",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx --env-file=.env server/index.ts",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "fetch:ielts-vocab": "node scripts/fetch-ielts-vocab.mjs",
    "fetch:gaokao-vocab": "node scripts/fetch-gaokao-vocab.mjs",
    "seed:official-vocab": "node --import tsx scripts/preload-official-vocab.ts",
    "seed:official-audio": "node --import tsx scripts/prewarm-official-audio.ts",
    "migrate:saved-words": "node --import tsx scripts/migrate-learning-groups-to-saved-words.ts",
    "cleanup:saved-library": "node --import tsx --env-file=.env scripts/cleanup-saved-library.ts",
    "backfill:forms": "node --import tsx --env-file=.env scripts/backfill-vocabulary-item-forms.ts",
    "import:ielts-reading": "node --import tsx --env-file=.env scripts/import-ielts-reading.ts",
    "import:ielts-reading-figures": "node --import tsx --env-file=.env scripts/import-ielts-reading-figures.ts",
    "import:ielts-listening": "node --import tsx --env-file=.env scripts/import-ielts-listening.ts",
    "lint": "tsc --noEmit",
    "check:production-api-base": "node scripts/check-production-api-base.mjs",
    "check:edge": "deno check supabase/functions/api/index.ts",
    "check:audit": "npm audit --audit-level=moderate",
    "test:review": "tsx scripts/test-review-rules.ts",
    "test:cloze": "tsx scripts/test-cloze.ts",
    "test:enrichment": "tsx scripts/test-enrichment-normalization.ts",
    "test:clickable-text": "tsx scripts/test-clickable-text-tokenizer.ts",
    "test:session": "tsx scripts/test-learning-session.ts",
    "test:word-batch": "tsx scripts/test-word-batch.ts",
    "test:routine-date": "tsx scripts/test-routine-date.ts",
    "test:official-library": "tsx scripts/test-official-library.ts",
    "test:hardening": "tsx scripts/test-enterprise-hardening-contracts.ts",
    "test:ielts-reading": "tsx scripts/test-ielts-reading-scoring.ts",
    "test:ielts-reading-text": "tsx scripts/test-ielts-reading-text.ts",
    "test:ielts-listening": "tsx scripts/test-ielts-listening-scoring.ts && tsx scripts/test-ielts-listening-import.ts",
    "test:core": "npm run test:review && npm run test:cloze && npm run test:enrichment && npm run test:clickable-text && npm run test:session && npm run test:word-batch && npm run test:routine-date && npm run test:official-library && npm run test:hardening",
    "test:ielts": "npm run test:ielts-reading && npm run test:ielts-reading-text && npm run test:ielts-listening",
    "test:all": "npm run test:core && npm run test:ielts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "animal-island-ui": "0.9.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
