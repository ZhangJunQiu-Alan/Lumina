# ──────────────────────────────────────────────────────────────────────────
# Lumina environment configuration — copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.
# Validation runs at server startup (see server/env.ts).
# ──────────────────────────────────────────────────────────────────────────

# ── Self-hosted data/auth (REQUIRED) ──────────────────────────────────────
# Base URL that exposes PostgREST at /rest/v1. On the server this is usually
# the local Nginx loopback URL; in browser builds use VITE_API_BASE_URL below.
LUMINA_DATA_URL=http://127.0.0.1
LUMINA_POSTGREST_URL=http://127.0.0.1:3001
LUMINA_SERVICE_ROLE_JWT=your-local-service-role-jwt

# Local PostgreSQL and auth. Keep these server-side only.
DATABASE_URL=postgresql://lumina:password@127.0.0.1:5432/lumina
LUMINA_AUTH_JWT_SECRET=your-random-jwt-secret

# Local object storage. Files are served from /storage/v1/object/public/...
LUMINA_LOCAL_STORAGE_ROOT=/var/lib/lumina/storage
LUMINA_PUBLIC_BASE_URL=https://your-api.example.com

# ── Legacy Supabase fallback (OPTIONAL) ───────────────────────────────────
# Leave these unset in the Tencent Cloud deployment. They remain only so older
# scripts can still target a Supabase project when explicitly needed.
# LUMINA_ALLOW_LEGACY_SUPABASE=false
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# LUMINA_SUPABASE_SERVICE_ROLE_KEY=

# ── AI content features (REQUIRED only when LUMINA_AI_FEATURES_ENABLED=true) ─
# Master switch for vocab/article generation + TTS endpoints.
LUMINA_AI_FEATURES_ENABLED=false
LUMINA_IELTS_LISTENING_ENABLED=true
# Mirror for the frontend so the UI can hide AI affordances.
VITE_AI_CONTENT_FEATURES_ENABLED=false
VITE_IELTS_LISTENING_ENABLED=true

# Google Gemini (generativelanguage.googleapis.com) — required if AI enabled.
GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides (defaults shown).
# GEMINI_ENRICH_MODEL=gemini-2.5-flash
# GEMINI_ARTICLE_MODEL=gemini-2.5-flash

# Google Cloud Text-to-Speech — required if AI enabled.
GOOGLE_TTS_API_KEY=your-google-tts-api-key

# ── Server runtime (OPTIONAL) ─────────────────────────────────────────────
# HTTP port for the Express server.
# PORT=4000
# production | development — affects log verbosity.
# NODE_ENV=development
# debug | info | warn | error
# LOG_LEVEL=info
# Allowed browser origins for CORS (single origin + comma-separated list).
# APP_ORIGIN=http://localhost:3000
# LUMINA_APP_ORIGINS=http://localhost:3000,https://your-app.example.com

# ── Rate-limit overrides (OPTIONAL) ───────────────────────────────────────
# Per-user budgets. Pattern: LUMINA_RATE_LIMIT_<GROUP>_<WINDOW>
# GROUP = AI_VOCAB | AI_ARTICLE | TTS    WINDOW = MINUTE | HOUR | DAY
# Defaults: ai_vocab 100/hour, 1000/day (no minute limit); ai_article 3/20/80; tts 60/500/2000.
# LUMINA_RATE_LIMIT_AI_VOCAB_HOUR=100
# LUMINA_RATE_LIMIT_AI_ARTICLE_HOUR=20
# LUMINA_RATE_LIMIT_TTS_DAY=2000

# ── Frontend feature flags (OPTIONAL) ─────────────────────────────────────
# Override the API base URL the browser talks to (defaults to same origin).
# VITE_API_BASE_URL=
# Enable Google OAuth sign-in button.
# VITE_GOOGLE_AUTH_ENABLED=false
# Enable personal vocabulary import UI.
# VITE_PERSONAL_VOCAB_IMPORT_ENABLED=false

# ── Supabase CLI (OPTIONAL — local tooling / migrations only) ──────────────
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
